# Local development defaults. For a live site follow docs/INSTALL.md: APP_ENV=production,
# APP_DEBUG=false, and APP_URL set to the exact https:// address members use (in production
# every link and gateway callback is built from it and other hosts are refused).
# After any change to this file on the server, run `php artisan config:cache`.
APP_NAME=Laravel
APP_ENV=local
# php artisan key:generate. Back it up off-server: documents, slips, welfare details and
# gateway secrets are encrypted with it.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# One-time token for the install wizard (/install). Without it (here or in
# storage/app/.install-token) the wizard is disabled. Use a random value of at
# least 16 characters, e.g. `php -r "echo bin2hex(random_bytes(24));"`. The
# wizard blanks it once the install succeeds.
INSTALL_TOKEN=

# Local demo seeder only (php artisan db:seed refuses outside local/testing):
# the demo super admin's password. Empty = a random one, printed once.
SEED_SUPER_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (database/database.sqlite) by default. For MySQL / MariaDB set DB_CONNECTION=mysql
# and the DB_* values below (docs/INSTALL.md, section 4).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (https only): the session cookie is never sent over plain http.
# The install wizard sets it to true when APP_URL is https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued today (emails are sent during the request), so no queue worker is needed.
QUEUE_CONNECTION=database

# database (or file) in production; never "array" (the pay lock and rate limits need it).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs/laravel.log. A live site needs real SMTP or no email goes
# out (welcome emails with temporary passwords, receipts, slip rejections): MAIL_MAILER=smtp,
# MAIL_SCHEME=smtps with port 465 (or smtp with 587), and the mailbox's host, username and
# password. See docs/INSTALL.md, step 8.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ToyyibPay — webhook secret is REQUIRED in production: a random value of at
# least 32 characters (shorter, empty or placeholder values reject every
# callback). Each bill's callback URL carries its own HMAC of this secret.
TOYYIBPAY_SECRET_KEY=your_secret_key_here
TOYYIBPAY_CATEGORY_CODE=your_category_code_here
TOYYIBPAY_SANDBOX=true
TOYYIBPAY_WEBHOOK_SECRET=
# Confirm each "paid" callback with ToyyibPay's getBillTransactions before
# settling (recommended). If the API is unreachable the fee is not settled and
# ToyyibPay retries the callback.
TOYYIBPAY_VERIFY_CALLBACK=true
# Only after the ToyyibPay sandbox confirms billChargeToCustomer semantics:
TOYYIBPAY_CHARGE_VERIFIED=false

# Billplz — X-Signature key is REQUIRED in production. Empty value
# rejects all incoming webhook calls (fail-closed).
BILLPLZ_API_KEY=your_billplz_api_key_here
BILLPLZ_COLLECTION_ID=your_billplz_collection_id_here
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true

# Reverse-proxy / load-balancer integration. Comma-separated list of proxy
# IPs/CIDRs to trust for X-Forwarded-* headers, or '*' if your edge strips
# client-supplied headers. Without this, request()->ip() returns the
# proxy IP and rate limiting becomes a global counter.
TRUSTED_PROXIES=
